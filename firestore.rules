rules_version = '2';

// 打卡系統 資料庫安全規則
// 重點：打卡時間只能是伺服器時間、手機必須綁定、打卡紀錄一經寫入不可修改或刪除
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().active == true;
    }
    function isAdmin() { return isActive() && me().role == 'admin'; }

    // 台灣時間（UTC+8）的年月、年月日，例如 202610、20261014
    function tw() { return request.time + duration.value(8, 'h'); }
    function ymNow() { return tw().year() * 100 + tw().month(); }
    function ymdNow() { return ymNow() * 100 + tw().day(); }
    // n 天後的台灣日期（例如 20261122）
    function ymdIn(n) {
      let t = request.time + duration.value(8, 'h') + duration.value(n, 'd');
      return (t.year() * 100 + t.month()) * 100 + t.day();
    }

    // ===== 簽核設定：主官／副主官（settings/approval）=====
    function approvalDoc() { return /databases/$(database)/documents/settings/approval; }
    function approval() {
      return exists(approvalDoc()) ? get(approvalDoc()).data : {'chief': null, 'deputy': null};
    }
    function chiefId() { return approval().get('chief', null); }
    function deputyId() { return approval().get('deputy', null); }
    function isTopEmp(e) { return e != null && (e == chiefId() || e == deputyId()); }
    function isTop() { return isActive() && isTopEmp(me().empId); }
    // 送出時應該先給誰：主官／副主官本人直接進入最終核定；其他人先給直屬主管
    function routedSup() { return isTopEmp(me().empId) ? null : me().get('supervisorEmpId', null); }
    function routeOk(d) {
      return d.supervisorEmpId == routedSup()
        && d.status == (d.supervisorEmpId == null ? 'pending_admin' : 'pending_supervisor');
    }
    // 直屬主管審核：1 天（8 小時）以內或主管本身是主官／副主官 → 直接生效；否則送最終核定
    function supReviewOk(hours) {
      return resource.data.status == 'pending_supervisor'
        && resource.data.supervisorEmpId == me().empId
        && request.resource.data.supBy == me().empId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'supBy', 'supAt', 'supNote'])
        && (request.resource.data.status == 'rejected'
            || (request.resource.data.status == 'approved' && (hours <= 8 || isTopEmp(me().empId)))
            || (request.resource.data.status == 'pending_admin' && hours > 8 && !isTopEmp(me().empId)));
    }
    // 主官／副主官最終核定（不能核定自己的申請）
    function finalReviewOk() {
      return isTop()
        && resource.data.status in ['pending_admin', 'pending']
        && resource.data.empId != me().empId
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.finalBy == me().empId
        && ((request.resource.data.finalRole == 'chief' && me().empId == chiefId())
            || (request.resource.data.finalRole == 'deputy' && me().empId == deputyId()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finalBy', 'finalAt', 'finalNote', 'finalRole']);
    }
    // 這次寫入是否由我把補打卡從審核中改成核准（同一批寫入）
    function corrApprovedByMe(cid) {
      return get(/databases/$(database)/documents/corrections/$(cid)).data.status in ['pending_supervisor', 'pending_admin', 'pending']
        && getAfter(/databases/$(database)/documents/corrections/$(cid)).data.status == 'approved'
        && (getAfter(/databases/$(database)/documents/corrections/$(cid)).data.get('supBy', null) == me().empId
            || getAfter(/databases/$(database)/documents/corrections/$(cid)).data.get('finalBy', null) == me().empId);
    }
    function corrOf(cid) { return get(/databases/$(database)/documents/corrections/$(cid)).data; }
    // 這次寫入是否由我把請假從審核中改成核准（同一批寫入）
    function leaveApprovedByMe(rid) {
      return get(/databases/$(database)/documents/requests/$(rid)).data.status in ['pending_supervisor', 'pending_admin']
        && getAfter(/databases/$(database)/documents/requests/$(rid)).data.status == 'approved'
        && getAfter(/databases/$(database)/documents/requests/$(rid)).data.kind == 'leave'
        && (getAfter(/databases/$(database)/documents/requests/$(rid)).data.get('supBy', null) == me().empId
            || getAfter(/databases/$(database)/documents/requests/$(rid)).data.get('finalBy', null) == me().empId);
    }

    // 直屬主管名單（管理後台自動維護 settings/supervisors.ids）
    function isSupervisor() {
      return isActive()
        && exists(/databases/$(database)/documents/settings/supervisors)
        && me().empId in get(/databases/$(database)/documents/settings/supervisors).data.ids;
    }
    // 請假一覽的內容必須和假單（寫入後的狀態）完全一致，所以誰同步都不會造假
    function leaveListOk(rid) {
      let r = getAfter(/databases/$(database)/documents/requests/$(rid)).data;
      let d = request.resource.data;
      return r.kind == 'leave'
        && d.keys().hasOnly(['empId', 'name', 'company', 'leaveType', 'hours', 'startDate', 'endDate', 'startHour', 'endHour', 'status'])
        && d.empId == r.empId && d.name == r.name && d.company == r.company
        && d.leaveType == r.leaveType && d.hours == r.hours
        && d.startDate == r.startDate && d.endDate == r.endDate
        && d.startHour == r.startHour && d.endHour == r.endHour
        && d.status == r.status;
    }

    function bootstrapPending() {
      return !exists(/databases/$(database)/documents/settings/bootstrap)
        && existsAfter(/databases/$(database)/documents/settings/bootstrap);
    }

    // ===== 員工編號 → 登入帳號 對照（登入前要查，所以允許讀單筆）=====
    match /logins/{empId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        || (signedIn() && bootstrapPending() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ===== 員工資料 =====
    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && bootstrapPending()
            && request.resource.data.role == 'admin' && request.resource.data.active == true);

      // 員工本人只能：第一次綁定手機、把「需要改密碼」標記改成 false
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId', 'mustChangePassword'])
            && (request.resource.data.deviceId == resource.data.deviceId
                || (resource.data.deviceId == null && request.resource.data.deviceId is string))
            && (request.resource.data.mustChangePassword == resource.data.mustChangePassword
                || request.resource.data.mustChangePassword == false));

      allow delete: if false;
    }

    // ===== 打卡紀錄 =====
    match /punches/{id} {
      allow get, list: if isAdmin() || (isActive() && resource.data.empId == me().empId);

      // 員工自己打卡
      allow create: if isActive()
        && request.resource.data.keys().hasAll(['uid', 'empId', 'name', 'company', 'type', 'mode', 'ts', 'ym', 'ymd',
                                                'lat', 'lng', 'accuracy', 'distance', 'customer', 'deviceId'])
        && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'type', 'mode', 'ts', 'ym', 'ymd',
                                                 'lat', 'lng', 'accuracy', 'distance', 'customer', 'deviceId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.empId == me().empId
        && request.resource.data.name == me().name
        && request.resource.data.company == me().company
        && request.resource.data.ts == request.time
        && request.resource.data.ym == ymNow()
        && request.resource.data.ymd == ymdNow()
        && request.resource.data.type in ['in', 'out']
        && request.resource.data.mode in ['office', 'field']
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && me().deviceId != null
        && request.resource.data.deviceId == me().deviceId
        && (request.resource.data.mode == 'office'
              ? request.resource.data.distance is number
              : (request.resource.data.customer is string && request.resource.data.customer.size() > 0));

      // 管理員核准補打卡時寫入
      allow create: if isAdmin() && request.resource.data.mode == 'correction';
      // 直屬主管、主官／副主官核准補打卡時，同一批寫入一筆補打卡紀錄（內容必須和補打卡申請一致）
      allow create: if isActive() && request.resource.data.mode == 'correction'
        && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'type', 'mode', 'ts', 'ym', 'ymd',
             'lat', 'lng', 'accuracy', 'distance', 'customer', 'note', 'correctionId', 'approvedBy', 'deviceId'])
        && request.resource.data.correctionId is string
        && corrApprovedByMe(request.resource.data.correctionId)
        && request.resource.data.approvedBy == me().empId
        && request.resource.data.uid == corrOf(request.resource.data.correctionId).uid
        && request.resource.data.empId == corrOf(request.resource.data.correctionId).empId
        && request.resource.data.type == corrOf(request.resource.data.correctionId).type
        && request.resource.data.ts is timestamp
        && corrOf(request.resource.data.correctionId).date.replace('-', '') == string(request.resource.data.ymd)
        && (request.resource.data.ts + duration.value(8, 'h')).year() * 10000
           + (request.resource.data.ts + duration.value(8, 'h')).month() * 100
           + (request.resource.data.ts + duration.value(8, 'h')).day() == request.resource.data.ymd;

      // 打卡紀錄不可修改、不可刪除（符合勞基法出勤紀錄保存要求）
      allow update, delete: if false;
    }

    // ===== 補打卡申請 =====
    // 流程：員工送出 → 直屬主管（pending_supervisor）核准即生效；沒有直屬主管或主官／副主官本人 → 最終核定（pending_admin）
    match /corrections/{id} {
      allow get, list: if isAdmin() || isTop()
        || (isActive() && (resource.data.empId == me().empId || resource.data.supervisorEmpId == me().empId));
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'date', 'time', 'type', 'reason', 'supervisorEmpId', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.empId == me().empId
        && routeOk(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.type in ['in', 'out']
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0;
      allow update: if isAdmin()
        || (isActive() && supReviewOk(0) && request.resource.data.status in ['approved', 'rejected'])
        || finalReviewOk();
      allow delete: if false;
    }

    // ===== 請假／加班申請 =====
    // 流程：員工送出 → 直屬主管（pending_supervisor）→ 超過 8 小時再給主官／副主官（pending_admin）→ 核准
    match /requests/{id} {
      allow get, list: if isAdmin() || isTop()
        || (isActive() && (resource.data.empId == me().empId || resource.data.supervisorEmpId == me().empId));

      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'kind',
             'leaveType', 'startDate', 'endDate', 'startHour', 'endHour',
             'date', 'startTime', 'endTime', 'comp',
             'hours', 'ym', 'reason', 'agent', 'agentName', 'supervisorEmpId', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.empId == me().empId
        && request.resource.data.name == me().name
        && request.resource.data.company == me().company
        && request.resource.data.kind in ['leave', 'overtime']
        && request.resource.data.hours is number
        && request.resource.data.hours > 0 && request.resource.data.hours <= 2000
        && request.resource.data.ym is int
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && (!('agent' in request.resource.data) || (request.resource.data.agent is string && request.resource.data.agent.size() <= 20))
        && (!('agentName' in request.resource.data) || (request.resource.data.agentName is string && request.resource.data.agentName.size() <= 50))
        && routeOk(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        // 員工本人取消審核中的申請
        || (isActive() && resource.data.empId == me().empId
            && resource.data.status in ['pending_supervisor', 'pending_admin']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))
        // 直屬主管審核
        || (isActive() && supReviewOk(resource.data.hours))
        // 主官／副主官最終核定
        || finalReviewOk();

      allow delete: if false;
    }

    // ===== 今日出勤看板：精簡資料（不含 GPS、假別、事由）=====
    // 每人每天一筆，員工打卡後自動更新；時間只能是伺服器時間
    match /presence/{id} {
      allow get, list: if isActive();
      allow create, update: if isAdmin()
        || (isActive()
            && id == string(request.resource.data.ymd) + '_' + me().empId
            && request.resource.data.keys().hasOnly(['ymd', 'empId', 'name', 'company', 'mode', 'customer', 'lastType', 'inAt', 'outAt', 'lastAt', 'corrId'])
            && request.resource.data.empId == me().empId
            && request.resource.data.name == me().name
            && request.resource.data.company == me().company
            && request.resource.data.ymd == ymdNow()
            && request.resource.data.lastType in ['in', 'out']
            && request.resource.data.mode in ['office', 'field']
            && request.resource.data.lastAt == request.time
            && (!('inAt' in request.resource.data) || request.resource.data.inAt == request.time
                || (resource != null && 'inAt' in resource.data && request.resource.data.inAt == resource.data.inAt))
            && (!('outAt' in request.resource.data) || request.resource.data.outAt == request.time
                || (resource != null && 'outAt' in resource.data && request.resource.data.outAt == resource.data.outAt)))
        // 主管核准「今天」的補打卡時，同一批更新看板
        || (isActive()
            && request.resource.data.corrId is string
            && corrApprovedByMe(request.resource.data.corrId)
            && request.resource.data.keys().hasOnly(['ymd', 'empId', 'name', 'company', 'mode', 'customer', 'lastType', 'inAt', 'outAt', 'lastAt', 'corrId'])
            && request.resource.data.ymd == ymdNow()
            && corrOf(request.resource.data.corrId).date.replace('-', '') == string(ymdNow())
            && request.resource.data.empId == corrOf(request.resource.data.corrId).empId
            && id == string(request.resource.data.ymd) + '_' + request.resource.data.empId
            && request.resource.data.lastAt == request.time);
      allow delete: if isAdmin();
    }
    // ===== 兼職上班預告：兼職自己登記未來 31 天內哪天會來 =====
    // 每人每天一筆（文件編號＝日期_員工編號），只能登記今天以後；過去的預告不能改或刪
    match /shifts/{id} {
      allow get, list: if isActive();
      allow create, update: if isAdmin()
        || (isActive() && me().empType == 'part'
            && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'date', 'ymd', 'start', 'end', 'updatedAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.empId == me().empId
            && request.resource.data.name == me().name
            && request.resource.data.company == me().company
            && id == request.resource.data.date + '_' + me().empId
            && request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.date.replace('-', '') == string(request.resource.data.ymd)
            && request.resource.data.ymd >= ymdNow()
            && request.resource.data.ymd <= ymdIn(31)
            && request.resource.data.start is string && request.resource.data.start.matches('^[0-2][0-9]:[0-5][0-9]$')
            && request.resource.data.end is string && request.resource.data.end.matches('^[0-2][0-9]:[0-5][0-9]$')
            && request.resource.data.start < request.resource.data.end
            && request.resource.data.updatedAt == request.time
            && (resource == null || (resource.data.empId == me().empId && resource.data.ymd >= ymdNow())));
      allow delete: if isAdmin()
        || (isActive() && resource.data.empId == me().empId && resource.data.ymd >= ymdNow());
    }

    // 請假時段（只有日期與時間，由管理後台依已核准假單自動同步）
    match /leaveBoard/{id} {
      allow get, list: if isActive();
      allow write: if isAdmin();
      // 主管核准請假時，同一批寫入看板（內容必須和假單一致）
      allow create, update: if isActive() && leaveApprovedByMe(id)
        && request.resource.data.keys().hasOnly(['empId', 'name', 'company', 'startDate', 'endDate', 'startHour', 'endHour'])
        && request.resource.data.empId == getAfter(/databases/$(database)/documents/requests/$(id)).data.empId
        && request.resource.data.name == getAfter(/databases/$(database)/documents/requests/$(id)).data.name
        && request.resource.data.company == getAfter(/databases/$(database)/documents/requests/$(id)).data.company
        && request.resource.data.startDate == getAfter(/databases/$(database)/documents/requests/$(id)).data.startDate
        && request.resource.data.endDate == getAfter(/databases/$(database)/documents/requests/$(id)).data.endDate
        && request.resource.data.startHour == getAfter(/databases/$(database)/documents/requests/$(id)).data.startHour
        && request.resource.data.endHour == getAfter(/databases/$(database)/documents/requests/$(id)).data.endHour;
    }

    // 全員請假一覽（不含事由）：直屬主管、主官／副主官、管理員可以看
    match /leaveList/{id} {
      allow get, list: if isAdmin() || isTop() || isSupervisor();
      allow write: if isAdmin();
      allow create, update: if isActive() && leaveListOk(id);
    }

    // ===== 系統設定 =====
    match /settings/supervisors {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /settings/approval {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /settings/directory {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /settings/holidays {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /settings/office {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /settings/bootstrap {
      allow get: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/settings/bootstrap)
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }
  }
}
