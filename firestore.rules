rules_version = '2';

// 打卡系統 資料庫安全規則
// 重點：打卡時間只能是伺服器時間、手機必須綁定、打卡紀錄一經寫入不可修改或刪除
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().active == true;
    }
    function isAdmin() { return isActive() && me().role == 'admin'; }

    // 台灣時間（UTC+8）的年月、年月日，例如 202610、20261014
    function tw() { return request.time + duration.value(8, 'h'); }
    function ymNow() { return tw().year() * 100 + tw().month(); }
    function ymdNow() { return ymNow() * 100 + tw().day(); }
    // n 天後的台灣日期（例如 20261122）
    function ymdIn(n) {
      let t = request.time + duration.value(8, 'h') + duration.value(n, 'd');
      return (t.year() * 100 + t.month()) * 100 + t.day();
    }

    function bootstrapPending() {
      return !exists(/databases/$(database)/documents/settings/bootstrap)
        && existsAfter(/databases/$(database)/documents/settings/bootstrap);
    }

    // ===== 員工編號 → 登入帳號 對照（登入前要查，所以允許讀單筆）=====
    match /logins/{empId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        || (signedIn() && bootstrapPending() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ===== 員工資料 =====
    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && bootstrapPending()
            && request.resource.data.role == 'admin' && request.resource.data.active == true);

      // 員工本人只能：第一次綁定手機、把「需要改密碼」標記改成 false
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId', 'mustChangePassword'])
            && (request.resource.data.deviceId == resource.data.deviceId
                || (resource.data.deviceId == null && request.resource.data.deviceId is string))
            && (request.resource.data.mustChangePassword == resource.data.mustChangePassword
                || request.resource.data.mustChangePassword == false));

      allow delete: if false;
    }

    // ===== 打卡紀錄 =====
    match /punches/{id} {
      allow get, list: if isAdmin() || (isActive() && resource.data.empId == me().empId);

      // 員工自己打卡
      allow create: if isActive()
        && request.resource.data.keys().hasAll(['uid', 'empId', 'name', 'company', 'type', 'mode', 'ts', 'ym', 'ymd',
                                                'lat', 'lng', 'accuracy', 'distance', 'customer', 'deviceId'])
        && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'type', 'mode', 'ts', 'ym', 'ymd',
                                                 'lat', 'lng', 'accuracy', 'distance', 'customer', 'deviceId'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.empId == me().empId
        && request.resource.data.name == me().name
        && request.resource.data.company == me().company
        && request.resource.data.ts == request.time
        && request.resource.data.ym == ymNow()
        && request.resource.data.ymd == ymdNow()
        && request.resource.data.type in ['in', 'out']
        && request.resource.data.mode in ['office', 'field']
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && me().deviceId != null
        && request.resource.data.deviceId == me().deviceId
        && (request.resource.data.mode == 'office'
              ? request.resource.data.distance is number
              : (request.resource.data.customer is string && request.resource.data.customer.size() > 0));

      // 管理員核准補打卡時寫入
      allow create: if isAdmin() && request.resource.data.mode == 'correction';

      // 打卡紀錄不可修改、不可刪除（符合勞基法出勤紀錄保存要求）
      allow update, delete: if false;
    }

    // ===== 補打卡申請 =====
    match /corrections/{id} {
      allow get, list: if isAdmin() || (isActive() && resource.data.empId == me().empId);
      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'date', 'time', 'type', 'reason', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.empId == me().empId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.type in ['in', 'out']
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ===== 請假／加班申請 =====
    // 流程：員工送出 → 直屬主管（pending_supervisor）→ 管理員（pending_admin）→ 核准
    match /requests/{id} {
      allow get, list: if isAdmin()
        || (isActive() && (resource.data.empId == me().empId || resource.data.supervisorEmpId == me().empId));

      allow create: if isActive()
        && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'kind',
             'leaveType', 'startDate', 'endDate', 'startHour', 'endHour',
             'date', 'startTime', 'endTime', 'comp',
             'hours', 'ym', 'reason', 'supervisorEmpId', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.empId == me().empId
        && request.resource.data.name == me().name
        && request.resource.data.company == me().company
        && request.resource.data.kind in ['leave', 'overtime']
        && request.resource.data.hours is number
        && request.resource.data.hours > 0 && request.resource.data.hours <= 2000
        && request.resource.data.ym is int
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0
        && request.resource.data.supervisorEmpId == me().get('supervisorEmpId', null)
        && request.resource.data.status == (request.resource.data.supervisorEmpId == null ? 'pending_admin' : 'pending_supervisor')
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        // 員工本人取消審核中的申請
        || (isActive() && resource.data.empId == me().empId
            && resource.data.status in ['pending_supervisor', 'pending_admin']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt']))
        // 直屬主管審核（核准後送管理員，或駁回）
        || (isActive() && resource.data.supervisorEmpId == me().empId
            && resource.data.status == 'pending_supervisor'
            && request.resource.data.status in ['pending_admin', 'rejected']
            && request.resource.data.supBy == me().empId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'supBy', 'supAt', 'supNote']));

      allow delete: if false;
    }

    // ===== 今日出勤看板：精簡資料（不含 GPS、假別、事由）=====
    // 每人每天一筆，員工打卡後自動更新；時間只能是伺服器時間
    match /presence/{id} {
      allow get, list: if isActive();
      allow create, update: if isAdmin()
        || (isActive()
            && id == string(request.resource.data.ymd) + '_' + me().empId
            && request.resource.data.keys().hasOnly(['ymd', 'empId', 'name', 'company', 'mode', 'customer', 'lastType', 'inAt', 'outAt', 'lastAt'])
            && request.resource.data.empId == me().empId
            && request.resource.data.name == me().name
            && request.resource.data.company == me().company
            && request.resource.data.ymd == ymdNow()
            && request.resource.data.lastType in ['in', 'out']
            && request.resource.data.mode in ['office', 'field']
            && request.resource.data.lastAt == request.time
            && (!('inAt' in request.resource.data) || request.resource.data.inAt == request.time
                || (resource != null && 'inAt' in resource.data && request.resource.data.inAt == resource.data.inAt))
            && (!('outAt' in request.resource.data) || request.resource.data.outAt == request.time
                || (resource != null && 'outAt' in resource.data && request.resource.data.outAt == resource.data.outAt)));
      allow delete: if isAdmin();
    }
    // ===== 兼職上班預告：兼職自己登記未來 31 天內哪天會來 =====
    // 每人每天一筆（文件編號＝日期_員工編號），只能登記今天以後；過去的預告不能改或刪
    match /shifts/{id} {
      allow get, list: if isActive();
      allow create, update: if isAdmin()
        || (isActive() && me().empType == 'part'
            && request.resource.data.keys().hasOnly(['uid', 'empId', 'name', 'company', 'date', 'ymd', 'start', 'end', 'updatedAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.empId == me().empId
            && request.resource.data.name == me().name
            && request.resource.data.company == me().company
            && id == request.resource.data.date + '_' + me().empId
            && request.resource.data.date is string
            && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.date.replace('-', '') == string(request.resource.data.ymd)
            && request.resource.data.ymd >= ymdNow()
            && request.resource.data.ymd <= ymdIn(31)
            && request.resource.data.start is string && request.resource.data.start.matches('^[0-2][0-9]:[0-5][0-9]$')
            && request.resource.data.end is string && request.resource.data.end.matches('^[0-2][0-9]:[0-5][0-9]$')
            && request.resource.data.start < request.resource.data.end
            && request.resource.data.updatedAt == request.time
            && (resource == null || (resource.data.empId == me().empId && resource.data.ymd >= ymdNow())));
      allow delete: if isAdmin()
        || (isActive() && resource.data.empId == me().empId && resource.data.ymd >= ymdNow());
    }

    // 請假時段（只有日期與時間，由管理後台依已核准假單自動同步）
    match /leaveBoard/{id} {
      allow get, list: if isActive();
      allow write: if isAdmin();
    }

    // ===== 系統設定 =====
    match /settings/directory {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /settings/holidays {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /settings/office {
      allow get: if isActive();
      allow write: if isAdmin();
    }
    match /settings/bootstrap {
      allow get: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/settings/bootstrap)
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }
  }
}
